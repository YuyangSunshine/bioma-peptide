# Copy this file to a private environment file and fill values locally.
# Never commit real credentials.

# LLM credentials for configs/bioma.yaml (keep NAME=value left-aligned).
CHATEXCEL_API_KEY=
# Optional legacy provider credential.
BAIDU_API_KEY=

# Optional local AlphaFold2 inference (ColabFold installation and weights).
BIOMA_COLABFOLD_BIN=
BIOMA_COLABFOLD_DATA=
BIOMA_COLABFOLD_GPU=0

# Current BioMA protocols.io read-only Tool.
# Supply either a client access token or an OAuth access token.
PROTOCOLS_IO_TOKEN=

# Reserved for a future OAuth authorization-code/refresh implementation.
# Current BioMA production code does not read these variables.
PROTOCOLS_IO_CLIENT_ID=
PROTOCOLS_IO_CLIENT_SECRET=
PROTOCOLS_IO_REDIRECT_URI=
PROTOCOLS_IO_REFRESH_TOKEN=
